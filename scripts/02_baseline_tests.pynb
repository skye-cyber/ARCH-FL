# Plotting template
def plot_results(accuracies):
    plt.figure(figsize=(10, 6))
    plt.plot(accuracies)
    plt.title('Federated Learning Accuracy Over Rounds')
    plt.xlabel('Communication Round')
    plt.ylabel('Test Accuracy (%)')
    plt.grid(True)
    plt.show()
